APP_ENV=development

# --- Database ---
# Local dev (SQLite, no server required):
DATABASE_URL=sqlite:///./shelter.db
# Production (PostgreSQL):
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/shelter

# --- JWT ---
JWT_SECRET_KEY=CHANGE_THIS
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Frontend / CORS ---
FRONTEND_URL=http://localhost:3000

# --- Google OAuth ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/v1/auth/google/callback

# --- GitHub OAuth ---
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://127.0.0.1:8000/api/v1/auth/github/callback

# --- NASA POWER ---
NASA_POWER_URL=https://power.larc.nasa.gov/api/temporal/climatology/point
